// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  EDITOR
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_2FA_PENDING
  LOGIN_2FA_SUCCESS
  LOGIN_2FA_FAILED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_EXPIRED
  PASSWORD_RESET_FORCED
  TWO_FA_ENABLED
  TWO_FA_DISABLED
  NEWS_CREATED
  NEWS_UPDATED
  NEWS_DELETED
  NEWS_PUBLISHED
  NEWS_UNPUBLISHED
  CONTENT_CREATED
  CONTENT_UPDATED
  CONTENT_DELETED
  ACCOUNT_LOCKED
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  role                Role      @default(EDITOR)
  passwordHash        String
  passwordChangedAt   DateTime  @default(now())
  is2faEnabled        Boolean   @default(false)
  totpSecretEncrypted String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  news     NewsPost[]
  auditLogs AuditLog[]

  @@index([email])
}

model NewsPost {
  id          String   @id @default(cuid())
  titleId     String   @db.VarChar(255)
  titleEn     String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  summaryId   String   @db.LongText
  summaryEn   String   @db.LongText
  contentId   String?  @db.LongText
  contentEn   String?  @db.LongText
  coverImage  String   @db.LongText
  date        DateTime @default(now())
  published   Boolean  @default(false)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([authorId])
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    AuditAction
  entity    String?
  entityId  String?
  detail    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([createdAt])
}

model HeroSlide {
  id         String   @id @default(cuid())
  order      Int      @default(0)
  titleId    String   @db.VarChar(255)
  titleEn    String   @db.VarChar(255)
  subtitleId String?  @db.LongText
  subtitleEn String?  @db.LongText
  ctaLabelId String?  @db.VarChar(255)
  ctaLabelEn String?  @db.VarChar(255)
  ctaHref    String?  @db.VarChar(255)
  image      String   @db.LongText
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active])
}

model CompanyContent {
  id         String   @id @default(cuid())
  titleId    String   @db.VarChar(255)
  titleEn    String   @db.VarChar(255)
  p1Id       String   @db.LongText
  p1En       String   @db.LongText
  p2Id       String   @db.LongText
  p2En       String   @db.LongText
  homeImage  String?  @db.LongText
  introId    String   @db.LongText
  introEn    String   @db.LongText
  visiId     String   @db.LongText
  visiEn     String   @db.LongText
  misiId     String   @db.LongText
  misiEn     String   @db.LongText
  licensesId Json     @db.Json
  licensesEn Json     @db.Json
  updatedAt  DateTime @updatedAt

  stats CompanyStat[]
}

model CompanyStat {
  id        String         @id @default(cuid())
  companyId String
  company   CompanyContent @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order     Int            @default(0)
  value     Int
  suffix    String         @db.VarChar(20)
  labelId   String         @db.VarChar(255)
  labelEn   String         @db.VarChar(255)

  @@index([companyId])
}

model ServiceItem {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  titleId   String   @db.VarChar(255)
  titleEn   String   @db.VarChar(255)
  descId    String   @db.LongText
  descEn    String   @db.LongText
  icon      String   @db.VarChar(50)
  iconColor String   @db.VarChar(50)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model CustomerLogo {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  image     String   @db.LongText
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model PartnerLogo {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  image     String   @db.LongText
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model FaqEntry {
  id         String   @id @default(cuid())
  order      Int      @default(0)
  questionId String   @db.LongText
  questionEn String   @db.LongText
  answerId   String   @db.LongText
  answerEn   String   @db.LongText
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active])
}

model ContactSetting {
  id                   String   @id @default(cuid())
  officeAddressId      String   @db.LongText
  officeAddressEn      String   @db.LongText
  operationalAddressId String   @db.LongText
  operationalAddressEn String   @db.LongText
  phone                String   @db.VarChar(50)
  phoneDisplay         String   @db.VarChar(50)
  email                String   @db.VarChar(255)
  whatsapp             String?  @db.VarChar(50)
  updatedAt            DateTime @updatedAt
}

model SocialMediaLink {
  id        String   @id @default(cuid())
  platform  String   @db.VarChar(30)
  url       String   @db.VarChar(255)
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}
